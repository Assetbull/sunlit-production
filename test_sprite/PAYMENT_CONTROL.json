{
    "suite": "Payment Control",
    "tests": [
        {
            "name": "Initiate Payment",
            "steps": [
                {
                    "action": "api_call",
                    "endpoint": "/payment/initiate",
                    "method": "POST",
                    "body": {
                        "contract_id": "contract_001",
                        "amount": 2500000
                    }
                },
                {
                    "assert_event": "payment_initiated"
                }
            ]
        },
        {
            "name": "Confirm Payment and Lock",
            "steps": [
                {
                    "action": "webhook_simulation",
                    "source": "paystack",
                    "payload": {
                        "status": "success",
                        "reference": "txn_123"
                    }
                },
                {
                    "assert_event": "payment_confirmed"
                },
                {
                    "assert_event": "payment_locked"
                }
            ]
        }
    ]
}