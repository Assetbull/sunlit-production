{
    "suite": "RFQ Distribution",
    "tests": [
        {
            "name": "Broadcast RFQ to Marketplace",
            "steps": [
                {
                    "action": "api_call",
                    "endpoint": "/rfq/publish",
                    "method": "POST",
                    "body": {
                        "rfq_id": "rfq_001"
                    }
                },
                {
                    "assert_event": "rfq_published"
                },
                {
                    "assert_event": "rfq_broadcasted"
                }
            ]
        },
        {
            "name": "Direct Invite Installer",
            "steps": [
                {
                    "action": "api_call",
                    "endpoint": "/rfq/invite",
                    "method": "POST",
                    "body": {
                        "rfq_id": "rfq_001",
                        "installer_ids": [
                            "installer_01"
                        ]
                    }
                },
                {
                    "assert_event": "rfq_invited"
                }
            ]
        }
    ]
}