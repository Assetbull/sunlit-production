{
  "name": "sunlit-production",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "sunlit-app"
  ],
  "scripts": {
    "dev": "cd sunlit-app && npm run dev",
    "build": "cd sunlit-app && npm run build",
    "vercel-build": "cd sunlit-app && npm install && npm run build",
    "start": "cd sunlit-app && npm run start",
    "lint": "cd sunlit-app && npm run lint",
    "security:scan": "python3 tools/sunlit-security-scanner/scanner.py --mode=full",
    "security:gate": "python3 tools/sunlit-security-scanner/scanner.py --mode=gate",
    "security:test": "cd sunlit-app && npx tsx --test src/security/__tests__/*.test.ts",
    "security:assurance": "cd sunlit-app && npm run test:security-assurance",
    "security:scanner-test": "python3 -m unittest discover -s tools/sunlit-security-scanner/tests",
    "perf:scan": "python3 tools/sunlit-performance-scanner/scanner.py --mode=full",
    "perf:gate": "python3 tools/sunlit-performance-scanner/scanner.py --mode=gate",
    "perf:test": "python3 -m unittest discover -s tools/sunlit-performance-scanner/tests"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.1.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@types/three": "^0.185.4",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "three": "^0.185.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
